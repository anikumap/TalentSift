generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String        @id @default(cuid())
  name          String
  retentionDays Int           @default(365)
  createdAt     DateTime      @default(now())
  users         User[]
  invites       Invite[]
  jobs          Job[]
  candidates    Candidate[]
  auditEvents   AuditEvent[]
  messages      Message[]
  subscription  Subscription?
  jobCredits    JobCredit[]
}

model User {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String       @unique
  passwordHash String
  name         String
  role         String
  createdAt    DateTime     @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Invite {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email      String
  role       String
  tokenHash  String       @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())
}

model Job {
  id           String               @id @default(cuid())
  orgId        String
  org          Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title        String
  roleFamily   String
  location     String
  payMin       Int
  payMax       Int
  shifts       String
  status       String               @default("DRAFT")
  slug         String               @unique
  adText       String               @default("")
  openedAt     DateTime?
  createdAt    DateTime             @default(now())
  scorecard    Scorecard?
  questions    WorkSampleQuestion[]
  applications Application[]
  jobCredits   JobCredit[]
}

model Scorecard {
  id        String     @id @default(cuid())
  jobId     String     @unique
  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skills    Skill[]
  mustHaves MustHave[]
}

model Skill {
  id          String       @id @default(cuid())
  scorecardId String
  scorecard   Scorecard    @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  name        String
  description String
  weight      Int
  keywords    String       @default("[]")
  order       Int          @default(0)
  evaluations Evaluation[]
}

model MustHave {
  id          String    @id @default(cuid())
  scorecardId String
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  label       String
  kind        String
  question    String
  order       Int       @default(0)
}

model WorkSampleQuestion {
  id       String @id @default(cuid())
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  prompt   String
  skillIds String @default("[]")
  order    Int    @default(0)
}

model Candidate {
  id           String        @id @default(cuid())
  orgId        String
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nameEnc      String
  emailEnc     String
  phoneEnc     String
  addressEnc   String
  emailHash    String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id              String       @id @default(cuid())
  jobId           String
  job             Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  publicRef       String
  stage           String       @default("APPLIED")
  consentAt       DateTime
  mustHaveAnswers String       @default("{}")
  answers         String       @default("{}")
  resumeText      String?
  resumeParsed    String?
  totalScore      Int          @default(0)
  evalStatus      String       @default("PENDING")
  revealed        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  evaluations     Evaluation[]
  selfId          SelfId?

  @@unique([jobId, publicRef])
  @@unique([jobId, candidateId])
}

/// Optional, voluntary self-description. Read only by the fairness monitor, in aggregate.
model SelfId {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  genderEnc     String?
  ageEnc        String?
  disabilityEnc String?
  createdAt     DateTime    @default(now())
}

model Evaluation {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  score         Int
  evidence      String      @default("[]")
  model         String
  promptVersion String
  createdAt     DateTime    @default(now())
}

model AuditEvent {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String
  jobId      String?
  reason     String?
  before     String?
  after      String?
  createdAt  DateTime     @default(now())

  @@index([orgId, createdAt])
}

model Message {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  to        String
  subject   String
  body      String
  kind      String
  createdAt DateTime     @default(now())
}

model Subscription {
  id               String       @id @default(cuid())
  orgId            String       @unique
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan             String       @default("TRIAL")
  status           String       @default("ACTIVE")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
}

model JobCredit {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  expiresAt DateTime
  createdAt DateTime     @default(now())
}
