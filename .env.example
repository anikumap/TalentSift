DATABASE_URL="file:./dev.db"
# 32-byte base64 key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"
# Production builds (`next start`) refuse the mock billing/email providers unless this is "true".
# Mock billing grants paid plans for free, so only enable it for demos.
ALLOW_MOCK_PROVIDERS="false"
